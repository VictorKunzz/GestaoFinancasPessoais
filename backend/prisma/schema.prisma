// Documentação do Prisma Schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Papel do usuario no sistema (controle de acesso ao painel admin)
enum Role {
  USER
  ADMIN
}

// Tabela de usuários
model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]
  badges       UserBadge[]
  categories   Category[]
  budgets      Budget[]
}

// Tabela de categorias (alimentação, transporte, lazer, etc).
// userId null = categoria padrao do sistema (global); caso contrario, pertence ao usuario.
model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  isDefault    Boolean       @default(false)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

// Tipo da transação: receita, despesa ou investimento
enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

// Tabela de transações financeiras (receitas e despesas)
model Transaction {
  id          String          @id @default(uuid())
  userId      String
  categoryId  String
  goalId      String?
  type        TransactionType
  description String
  amount      Decimal
  date        DateTime
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
  category    Category        @relation(fields: [categoryId], references: [id])
  goal        Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// Tabela de metas financeiras.
// savedAmount e alimentado automaticamente pelas transacoes de despesa vinculadas (aportes).
model Goal {
  id           String        @id @default(uuid())
  userId       String
  name         String
  targetAmount Decimal
  savedAmount  Decimal       @default(0)
  deadline     DateTime?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

// Orcamento mensal por categoria (alerta de estouro)
model Budget {
  id           String   @id @default(uuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

// Conjunto fixo de regras de conquista. O painel admin escolhe uma destas ao criar/editar badges.
enum BadgeCondition {
  FIRST_TRANSACTION
  FIRST_GOAL
  GOAL_REACHED
  POSITIVE_MONTH
  SPENT_LESS
}

// Tabela de medalhas disponíveis no sistema
model Badge {
  id          String         @id @default(uuid())
  name        String
  description String
  icon        String?
  condition   BadgeCondition
  userBadges  UserBadge[]
}

// Tabela que liga usuário às medalhas que ele conquistou
model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])
}
